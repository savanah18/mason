# Model configuration for TensorRT-optimized Qwen3-VL
# Auto-generated template - customize as needed

name: "qwen3-vl-tensorrt"
backend: "tensorrt"

default_model_filename: "engine.trt"

max_batch_size: 32

dynamic_batching {
  preferred_batch_size: [ 4, 8, 16 ]
  max_queue_delay_microseconds: 100
}

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1, 512 ]
    reshape { shape: [ -1, 512 ] }
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1, 512 ]
    reshape { shape: [ -1, 512 ] }
  }
]

output [
  {
    name: "last_hidden_state"
    data_type: TYPE_FP32
    dims: [ -1, 512, 768 ]
    reshape { shape: [ -1, 512, 768 ] }
  },
  {
    name: "pooler_output"
    data_type: TYPE_FP32
    dims: [ -1, 768 ]
    reshape { shape: [ -1, 768 ] }
  }
]

instance_group [
  {
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator {
      # TensorRT uses the specified GPU for execution
    }
  }
}
