name: "qwen3-postprocessing"
backend: "python"
max_batch_size: 8

input [
  {
    name: "output_ids"
    data_type: TYPE_INT32
    dims: [ -1, -1 ]
  },
  {
    name: "sequence_length"
    data_type: TYPE_INT32
    dims: [ -1 ]
  },
  {
    name: "input_length"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

output [
  {
    name: "text_output"
    data_type: TYPE_STRING
    dims: [ -1 ]
  },
  {
    name: "usage"
    data_type: TYPE_INT32
    dims: [ 3 ]  # [prompt_tokens, completion_tokens, total_tokens]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

parameters {
  key: "EXECUTION_ENV_PATH"
  value: {string_value: "/opt/tritonserver/backends/python/triton_python_backend_env.tar.gz"}
}
