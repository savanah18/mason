name: "qwen3-preprocessing"
backend: "python"
max_batch_size: 8

input [
  {
    name: "messages"
    data_type: TYPE_STRING
    dims: [ -1 ]
  },
  {
    name: "max_tokens"
    data_type: TYPE_INT32
    dims: [ 1 ]
    optional: true
  },
  {
    name: "temperature"
    data_type: TYPE_FP32
    dims: [ 1 ]
    optional: true
  },
  {
    name: "top_p"
    data_type: TYPE_FP32
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "INPUT_IDS"
    data_type: TYPE_INT32
    dims: [ -1, -1 ]
  },
  {
    name: "REQUEST_OUTPUT_LEN"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "TEMPERATURE"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "TOP_P"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "INPUT_LENGTH"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

parameters {
  key: "EXECUTION_ENV_PATH"
  value: {string_value: "/opt/tritonserver/backends/python/triton_python_backend_env.tar.gz"}
}
