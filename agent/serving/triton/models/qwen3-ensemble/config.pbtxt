name: "qwen3-ensemble"
platform: "ensemble"
max_batch_size: 8

# Ensemble accepts OpenAI-style inputs and returns text
input [
  {
    name: "messages"
    data_type: TYPE_STRING
    dims: [ -1 ]
  },
  {
    name: "max_tokens"
    data_type: TYPE_INT32
    dims: [ 1 ]
    optional: true
  },
  {
    name: "temperature"
    data_type: TYPE_FP32
    dims: [ 1 ]
    optional: true
  },
  {
    name: "top_p"
    data_type: TYPE_FP32
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "text_output"
    data_type: TYPE_STRING
    dims: [ -1 ]
  },
  {
    name: "usage"
    data_type: TYPE_INT32
    dims: [ 3 ]  # [prompt_tokens, completion_tokens, total_tokens]
  }
]

# Ensemble scheduling: preprocessing → tensorrt-llm → postprocessing
ensemble_scheduling {
  # Step 1: Preprocessing (tokenization)
  step [
    {
      model_name: "qwen3-preprocessing"
      model_version: -1
      input_map {
        key: "messages"
        value: "messages"
      }
      input_map {
        key: "max_tokens"
        value: "max_tokens"
      }
      input_map {
        key: "temperature"
        value: "temperature"
      }
      input_map {
        key: "top_p"
        value: "top_p"
      }
      output_map {
        key: "INPUT_IDS"
        value: "input_ids"
      }
      output_map {
        key: "REQUEST_OUTPUT_LEN"
        value: "request_output_len"
      }
      output_map {
        key: "TEMPERATURE"
        value: "temperature_tensor"
      }
      output_map {
        key: "TOP_P"
        value: "top_p_tensor"
      }
      output_map {
        key: "INPUT_LENGTH"
        value: "input_length"
      }
    }
  ]

  # Step 2: TensorRT-LLM inference
  step [
    {
      model_name: "qwen3-tensorrtllm"
      model_version: -1
      input_map {
        key: "input_ids"
        value: "input_ids"
      }
      input_map {
        key: "request_output_len"
        value: "request_output_len"
      }
      input_map {
        key: "temperature"
        value: "temperature_tensor"
      }
      input_map {
        key: "runtime_top_p"
        value: "top_p_tensor"
      }
      output_map {
        key: "output_ids"
        value: "output_ids"
      }
      output_map {
        key: "sequence_length"
        value: "sequence_length"
      }
    }
  ]

  # Step 3: Postprocessing (detokenization)
  step [
    {
      model_name: "qwen3-postprocessing"
      model_version: -1
      input_map {
        key: "output_ids"
        value: "output_ids"
      }
      input_map {
        key: "sequence_length"
        value: "sequence_length"
      }
      input_map {
        key: "input_length"
        value: "input_length"
      }
      output_map {
        key: "text_output"
        value: "text_output"
      }
      output_map {
        key: "usage"
        value: "usage"
      }
    }
  ]
}
